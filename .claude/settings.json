{
  "enabledPlugins": {
    "engineering@synced": false,
    "pdf-viewer@synced": false,
    "cowork-plugin-management@synced": false
  },
  "skillOverrides": {
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "keybindings-help": "off",
    "claude-api": "off",
    "workflow-authoring": "off",
    "plugin-authoring": "off"
  },
  "permissions": {
    "deny": [
      "WebSearch",
      "mcp__Claude_Docs"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__(?!github__|claude-code-remote__)",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Blocked: in this repository only the github and claude-code-remote MCP servers may be used. claude.ai connectors (mail, calendar, files, docs) are off here.' >&2; exit 2"
          }
        ]
      },
      {
        "matcher": "^Skill$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-allowlist.sh\" check"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/skill-allowlist.sh\" sync"
          }
        ]
      }
    ]
  }
}
